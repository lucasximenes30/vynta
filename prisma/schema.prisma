generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(uuid())
  name                  String
  email                 String                 @unique
  phone                 String?
  password              String
  forcePasswordChange   Boolean                @default(false)
  role                  UserRole               @default(LEGACY)
  plan                  UserPlan               @default(FREE)
  subscriptionStatus    UserSubscriptionStatus @default(INACTIVE)
  subscriptionId        String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  sex                   UserSex?
  document              String?
  billingApprovedAt     DateTime?
  billingEmail          String?
  billingProvider       String?                @default("cakto")
  billingCustomerId     String?
  caktoOrderId          String?
  caktoSubscriptionId   String?
  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?
  subscriptionExpiresAt DateTime?
  hasWorkoutModule      Boolean                @default(false)
  canUseFinance         Boolean                @default(true)
  canUseHabits          Boolean                @default(true)
  canUseWorkout         Boolean                @default(true)
  canUseGoals           Boolean                @default(false)
  canUseNotes           Boolean                @default(false)
  canUseAgenda          Boolean                @default(false)
  usedUpgradeOffer      Boolean                @default(false)
  hasSeenDashboard      Boolean                @default(false)

  cards                 Card[]
  customCategories      Category[]
  exercises             Exercise[]
  habits                Habit[]
  monthlyReports        MonthlyReport[]
  notifications         Notification[]
  transactions          Transaction[]
  stats                 UserStats?
  workoutDayAssignments WorkoutDayAssignment[]
  workoutLogs           WorkoutLog[]
  workoutPlans          WorkoutPlan[]
  workoutSessions       WorkoutSession[]
  paymentTransactions   PaymentTransaction[]
  calendarEvents        CalendarEvent[]
  financialGoals        FinancialGoal[]
  notes                 Note[]
  adminActionsGiven     AdminActionLog[]       @relation("AdminActions")
  adminActionsReceived  AdminActionLog[]       @relation("TargetUserActions")
  lifeEvents            LifeEvent[]
  pushSubscriptions     PushSubscription[]
  notificationPrefs     NotificationPreference?
  pushLogs              PushLog[]

  @@map("users")
}

model PaymentTransaction {
  id                    String        @id @default(uuid())
  userId                String
  provider              String        @default("abacatepay")
  providerTransactionId String?       @unique
  amount                Decimal?      @db.Decimal(12, 2)
  paymentMethod         String?
  status                PaymentStatus @default(PENDING)
  rawStatus             String?
  paidAt                DateTime?
  expiresAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("payment_transactions")
}

model AdminActionLog {
  id           String   @id @default(uuid())
  adminId      String
  targetUserId String?
  action       String
  description  String?
  metadata     Json?
  createdAt    DateTime @default(now())
  admin        User     @relation("AdminActions", fields: [adminId], references: [id], onDelete: Cascade)
  targetUser   User?    @relation("TargetUserActions", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([targetUserId])
  @@index([createdAt])
  @@map("admin_action_logs")
}

model UserStats {
  id              String    @id @default(uuid())
  userId          String    @unique
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  score           Int       @default(0)
  lastWorkoutDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([score])
  @@map("user_stats")
}

model Transaction {
  id                String          @id @default(uuid())
  title             String
  amount            Decimal         @db.Decimal(12, 2)
  installmentAmount Decimal?        @db.Decimal(12, 2)
  type              TransactionType
  category          String
  date              DateTime
  userId            String
  isInstallment     Boolean         @default(false)
  totalInstallments Int?
  purchaseDate      DateTime?
  dueDay            Int?
  isRecurring       Boolean         @default(false)
  recurringDay      Int?
  isActive          Boolean         @default(true)
  endDate           DateTime?
  cardId            String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  paymentMethod     String?
  card              Card?           @relation(fields: [cardId], references: [id])
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes             Note[]
  goalTransactions  GoalTransaction[]

  @@index([userId, date])
  @@index([userId, isInstallment])
  @@index([userId, isRecurring])
  @@index([cardId])
  @@map("transactions")
}

model Card {
  id             String        @id @default(uuid())
  userId         String
  name           String
  lastFourDigits String
  dueDay         Int
  closingDay     Int
  color          String        @default("blue")
  limitAmount    Decimal       @default(0) @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]

  @@index([userId])
  @@map("cards")
}

model MonthlyReport {
  id               String   @id @default(uuid())
  userId           String
  year             Int
  month            Int
  income           Decimal  @default(0) @db.Decimal(12, 2)
  expense          Decimal  @default(0) @db.Decimal(12, 2)
  transactionCount Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([userId, year, month])
  @@map("monthly_reports")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  icon      String
  color     String
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("categories")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  date      DateTime
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@map("notifications")
}

model Habit {
  id          String         @id @default(uuid())
  userId      String
  title       String
  description String?
  icon        String         @default("Target")
  color       String         @default("blue")
  order       Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  checkins    HabitCheckin[]
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
  @@map("habits")
}

model HabitCheckin {
  id        String   @id @default(uuid())
  habitId   String
  date      String
  completed Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId])
  @@map("habit_checkins")
}

model WorkoutPlan {
  id             String                 @id @default(uuid())
  userId         String
  name           String
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  dayAssignments WorkoutDayAssignment[]
  days           WorkoutDay[]
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions       WorkoutSession[]

  @@index([userId, isActive])
  @@map("workout_plans")
}

model WorkoutDay {
  id             String                 @id @default(uuid())
  planId         String
  name           String
  order          Int
  weekDay        Int?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  dayAssignments WorkoutDayAssignment[]
  exercises      WorkoutDayExercise[]
  plan           WorkoutPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  workoutLogs    WorkoutLog[]
  sessions       WorkoutSession[]

  @@index([planId, order])
  @@map("workout_days")
}

model Exercise {
  id                  String                   @id @default(uuid())
  namePt              String
  nameEn              String
  muscleGroup         ExerciseMuscleGroup
  equipment           String?
  imageUrl            String?
  isSystem            Boolean                  @default(true)
  userId              String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  externalId          String?
  source              ExerciseSource           @default(SYSTEM)
  user                User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutDayExercises WorkoutDayExercise[]
  workoutExerciseLogs WorkoutExerciseLog[]
  sessionExercises    WorkoutSessionExercise[]

  @@unique([source, externalId])
  @@index([source, externalId])
  @@index([isSystem, muscleGroup])
  @@index([userId, createdAt])
  @@map("exercises")
}

model WorkoutDayExercise {
  id           String     @id @default(uuid())
  workoutDayId String
  exerciseId   String
  order        Int
  sets         Int
  reps         String
  targetWeight Decimal?   @db.Decimal(8, 2)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  exercise     Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  workoutDay   WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)

  @@index([workoutDayId, order])
  @@index([exerciseId])
  @@map("workout_day_exercises")
}

model WorkoutSession {
  id           String                   @id @default(uuid())
  userId       String
  planId       String
  workoutDayId String
  date         DateTime                 @default(now())
  completed    Boolean                  @default(false)
  dayNotes     String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  exercises    WorkoutSessionExercise[]
  plan         WorkoutPlan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutDay   WorkoutDay               @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([planId])
  @@index([workoutDayId])
  @@map("workout_sessions")
}

model WorkoutSessionExercise {
  id               String                      @id @default(uuid())
  workoutSessionId String
  exerciseId       String
  setsDone         Int?
  repsDone         String?
  weightUsed       Decimal?                    @db.Decimal(8, 2)
  completed        Boolean                     @default(false)
  notes            String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  exercise         Exercise                    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  workoutSession   WorkoutSession              @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  sets             WorkoutSessionExerciseSet[]

  @@index([workoutSessionId])
  @@index([exerciseId])
  @@map("workout_session_exercises")
}

model WorkoutSessionExerciseSet {
  id                       String                 @id @default(uuid())
  workoutSessionExerciseId String
  setNumber                Int
  plannedReps              String?
  actualReps               Int?
  weight                   Decimal?               @db.Decimal(8, 2)
  completed                Boolean                @default(false)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  workoutSessionExercise   WorkoutSessionExercise @relation(fields: [workoutSessionExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutSessionExerciseId])
  @@map("workout_session_exercise_sets")
}

model WorkoutDayAssignment {
  id           String      @id @default(uuid())
  userId       String
  planId       String
  workoutDayId String
  date         String
  createdAt    DateTime    @default(now())
  plan         WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutDay   WorkoutDay  @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([planId])
  @@index([workoutDayId])
  @@map("workout_day_assignments")
}

model WorkoutLog {
  id           String               @id @default(uuid())
  userId       String
  workoutId    String
  date         DateTime             @default(now())
  completed    Boolean              @default(false)
  notes        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  exerciseLogs WorkoutExerciseLog[]
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout      WorkoutDay           @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@unique([userId, workoutId, date])
  @@index([userId, date])
  @@index([workoutId])
  @@map("workout_logs")
}

model WorkoutExerciseLog {
  id           String     @id @default(uuid())
  workoutLogId String
  exerciseId   String
  done         Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  exercise     Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  workoutLog   WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)

  @@unique([workoutLogId, exerciseId])
  @@index([exerciseId])
  @@map("workout_exercise_logs")
}

enum PaymentStatus {
  PENDING
  ACTIVE
  FAILED
  EXPIRED
  CANCELED
}

enum UserPlan {
  FREE
  FREE_TRIAL
  VIP
  PRO
  PRO_YEARLY
  COURTESY
  ADMIN
}

enum UserSex {
  MALE
  FEMALE
  PREFER_NOT_SAY
}

enum UserSubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELED
  PENDING
  REFUSED
  PAST_DUE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum ExerciseMuscleGroup {
  CHEST
  BACK
  LEGS
  SHOULDERS
  BICEPS
  TRICEPS
  ABS
  GLUTES
  CARDIO
  FULL_BODY
  OTHER
}

enum ExerciseSource {
  SYSTEM
  CUSTOM
  WGER
}

enum UserRole {
  USER
  ADMIN
  LEGACY
  COURTESY
}

model CalendarEvent {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  date        DateTime
  startTime   String? // HH:mm format
  endTime     String? // HH:mm format
  isAllDay    Boolean  @default(false)
  category    String?
  color       String   @default("bg-brand-500")

  isRecurring Boolean @default(false)
  recurrence  String? // DAILY, WEEKLY, MONTHLY

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     Note[]

  @@index([userId])
  @@index([userId, date])
  @@map("calendar_events")
}

model FinancialGoal {
  id            String            @id @default(uuid())
  userId        String
  title         String
  targetAmount  Decimal           @db.Decimal(12, 2)
  currentAmount Decimal           @default(0) @db.Decimal(12, 2)
  deadline      DateTime?
  category      String?
  description   String?
  color         String            @default("blue")
  icon          String            @default("Target")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  GoalTransaction[]
  notes         Note[]

  @@index([userId])
  @@map("financial_goals")
}

model GoalTransaction {
  id          String        @id @default(uuid())
  goalId      String
  amount      Decimal       @db.Decimal(12, 2)
  type        String        @default("DEPOSIT") // DEPOSIT, WITHDRAW
  date        DateTime      @default(now())
  description String?
  goal        FinancialGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  transactionId String?
  transaction   Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([goalId])
  @@map("goal_transactions")
}

model Note {
  id       String  @id @default(uuid())
  userId   String
  title    String?
  content  String  @db.Text
  category String?
  isPinned Boolean @default(false)
  color    String  @default("default")

  financialGoalId String?
  eventId         String?
  transactionId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  financialGoal FinancialGoal? @relation(fields: [financialGoalId], references: [id], onDelete: SetNull)
  event         CalendarEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  transaction   Transaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("notes")
}

model FunnelEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String
  userId     String?  @db.Uuid
  eventName  String
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([sessionId])
  @@index([eventName])
  @@map("funnel_events")
}

// Legacy table present in the database (not used by the app). Kept in the schema so that
// `prisma db push` / migrations never drop it.
model LifeEvent {
  id          String        @id
  userId      String
  type        LifeEventType
  title       String
  description String?
  metadata    Json?
  sourceId    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([userId, createdAt])
  @@map("life_events")
}

enum LifeEventType {
  WORKOUT
  TRANSACTION
  HABIT
  GOAL
  NOTE
  SYSTEM
}

// Web Push (PWA notifications). One row per browser/device that accepted notifications.
model PushSubscription {
  id         String    @id @default(uuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model NotificationPreference {
  userId    String   @id
  bills     Boolean  @default(true)
  agenda    Boolean  @default(true)
  habits    Boolean  @default(true)
  dailyLog  Boolean  @default(true)
  timezone  String   @default("America/Sao_Paulo")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// Dedup of scheduled pushes: a (userId, key) row is claimed before sending, so cron
// retries/overlaps never notify twice.
model PushLog {
  id        String   @id @default(uuid())
  userId    String
  key       String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([createdAt])
  @@map("push_logs")
}
