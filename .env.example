# AI configuration by feature
AI_PROVIDER_REPORTS="groq"
AI_MODEL_REPORTS="llama-3.1-8b-instant"

# Optional fallback provider/model (used when primary fails with rate-limit/provider errors)
AI_PROVIDER_FALLBACK="groq"
AI_MODEL_FALLBACK="llama-3.1-8b-instant"

# Provider keys (global)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""

# Optional provider keys per slot (override global keys)
# GEMINI_API_KEY_REPORTS=""
# GEMINI_API_KEY_FALLBACK=""
# OPENAI_API_KEY_REPORTS=""
# OPENAI_API_KEY_FALLBACK=""

# BlackPayments Billing Config
BLACKPAY_PUBLIC_KEY=""
BLACKPAY_SECRET_KEY=""
BLACKPAY_WEBHOOK_SECRET="your_webhook_secret_here"
BLACKPAY_API_URL="https://api.blackpayments.pro/v1"

# Web Push (PWA notifications). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@vynta.digital"
# Protects /api/cron/push (Vercel Cron sends it automatically as a Bearer token)
CRON_SECRET=""
