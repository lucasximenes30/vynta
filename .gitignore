node_modules/
.next/
.env
.env.local
*.tsbuildinfo
out/
dist/
.cache/
.agents
.claude
.qwen
.idea/
# Generated after next build for offline lazy chunks
/public/offline-assets.json

# Pasta de conteúdo Instagram — viaja via zip entre PCs, só o README fica versionado
marketing/*
!marketing/README.md
# Fontes e propostas do rebranding precisam viajar com a branch
!marketing/branding/

# Credenciais locais do Zernio (o real fica em ~/.zernio, fora do repo)
.zernio
# Template vigente para novos posts; lotes históricos continuam locais
!marketing/instagram/
marketing/instagram/*
!marketing/instagram/variavel-de-post/
marketing/instagram/variavel-de-post/*
!marketing/instagram/variavel-de-post/README.md
!marketing/instagram/variavel-de-post/template.html
# Launch package stays with the rebranding branch; older local batches remain untouched.
!marketing/instagram/rascunhos/
marketing/instagram/rascunhos/*
!marketing/instagram/rascunhos/nova-fase/
